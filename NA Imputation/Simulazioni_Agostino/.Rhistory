time_prev <- 0
#Previsione
if (Distrib == "Gamma") {
prev_BC <- exp(predict(fit_BC, filter(na_data, is.na(BC_t))))
} else if (Distrib == "Normal") {
prev_BC <- predict(fit_BC, filter(na_data, is.na(BC_t)))
}
#Aggiornamento
may_data[which(is.na(may_data$`Black Carbon`) & may_data$DatetimeBegin == h_times[i]), "Black Carbon"] <- prev_BC
}
}
toc()
}
